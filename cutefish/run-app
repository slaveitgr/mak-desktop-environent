#!/bin/sh
set -eu
MAKOS_SOURCE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export QT_QUICK_CONTROLS_STYLE=Basic
if [ "$MAKOS_SOURCE" = /opt/makos ] && [ -f /etc/makos/live.json ]; then
    exec "$MAKOS_SOURCE/cutefish/build/venv/bin/python" "$MAKOS_SOURCE/main.py" --root "$HOME" --cutefish-app "$@"
fi
exec "$MAKOS_SOURCE/cutefish/build/venv/bin/python" "$MAKOS_SOURCE/main.py" --cutefish-app "$@"
