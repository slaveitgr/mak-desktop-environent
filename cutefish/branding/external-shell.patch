+std::string WindowDebugService::GetWindowMenu(uint64_t id) const
+{
+    const wm::Window *window = m_manager->windowById(id);
+    const auto model = window && window->role() == wm::WindowRole::Normal && window->rootSurface()
+            ? window->rootSurface()->mainMenu() : nullptr;
+    Value::Array items;
+    if (model) {
+        std::vector<int32_t> pending {0};
+        std::set<int32_t> seen;
+        for (size_t i = 0; i < pending.size() && seen.size() < 4096; ++i) {
+            const int32_t key = pending[i];
+            if (!seen.insert(key).second)
+                continue;
+            const compositor::MenuItem *item = model->item(key);
+            if (!item)
+                continue;
+            Value::Array children, shortcuts;
+            for (int32_t child : item->children) {
+                children.push_back(child);
+                if (pending.size() < 8192)
+                    pending.push_back(child);
+            }
+            for (const auto &combination : item->shortcut) {
+                Value::Array keys;
+                for (const std::string &key : combination)
+                    keys.push_back(key);
+                shortcuts.push_back(std::move(keys));
+            }
+            items.push_back(Value::object({
+                {"id", item->id}, {"parent", item->parent},
+                {"label", compositor::plainMenuLabel(item->label)},
+                {"enabled", item->enabled}, {"visible", item->visible},
+                {"separator", item->separator}, {"iconName", item->iconName},
+                {"shortcut", std::move(shortcuts)}, {"toggle", int(item->toggle)},
+                {"toggleState", item->toggleState}, {"role", int(item->role)},
+                {"hasSubmenu", item->hasSubmenu}, {"childrenLoaded", item->childrenLoaded},
+                {"children", std::move(children)}
+            }));
+        }
+    }
+    return Value::object({{"windowId", std::to_string(id)}, {"available", bool(model)},
+                          {"source", model ? "cutefish-main-menu-v1" : "unavailable"},
+                          {"items", std::move(items)}}).serialize();
+}
+
+bool WindowDebugService::MenuEvent(uint64_t id, int32_t itemId, const std::string &event)
+{
+    const wm::Window *window = m_manager->windowById(id);
+    const auto model = window && window->role() == wm::WindowRole::Normal && window->rootSurface()
+            ? window->rootSurface()->mainMenu() : nullptr;
+    if (!model)
+        return false;
+    const compositor::MenuItem *item = model->item(itemId);
+    if (!item || !item->visible)
+        return false;
+    if (event == "prepare") model->prepare(itemId);
+    else if (event == "opened") model->opened(itemId);
+    else if (event == "closed") model->closed(itemId);
+    else if (event == "activate" && item->enabled && !item->separator) model->activate(itemId);
+    else return false;
+    return true;
+}
+
+bool WindowDebugService::CloseWindow(uint64_t id)
+{
+    wm::Window *window = m_manager->windowById(id);
+    if (!window || window->role() != wm::WindowRole::Normal || window->isPopup())
+        return false;
+    window->requestClose();
+    return true;
+}
+
+bool WindowDebugService::SetWindowFullscreen(uint64_t id, bool fullscreen)
+{
+    wm::Window *window = m_manager->windowById(id);
+    if (!window || window->role() != wm::WindowRole::Normal || window->isPopup())
+        return false;
+    window->setFullscreen(fullscreen);
+    return true;
+}
+
+bool WindowDebugService::SetMinimizeTarget(uint64_t id, int x, int y, int width, int height)
+{
+    wm::Window *window = m_manager->windowById(id);
+    if (!window || window->role() != wm::WindowRole::Normal || width < 0 || height < 0
+        || width > 16384 || height > 16384 || x < -1048576 || x > 1048576 || y < -1048576 || y > 1048576)
+        return false;
+    window->setMinimizedGeometry(base::Rect(x, y, width, height));
+    return true;
+}
+
+std::string WindowDebugService::WorkAreas() const
+{
+    Value::Array areas;
+    for (const auto &output : m_manager->outputAreas())
+        areas.push_back(Value::object({{"bounds", rectArray(output.bounds)},
+                                      {"workArea", rectArray(m_manager->restingWorkAreaForOutput(output.bounds))}}));
+    return Value(std::move(areas)).serialize();
+}
