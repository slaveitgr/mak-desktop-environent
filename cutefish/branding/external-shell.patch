+void shellSurfaceSetPosition(wl_client*, wl_resource* resource, int32_t x, int32_t y)
+{
+    if (x < -1048576 || x > 1048576 || y < -1048576 || y > 1048576) {
+        wl_resource_post_error(resource, CUTEFISH_SHELL_SURFACE_V1_ERROR_INVALID_GEOMETRY,
+                               "shell position is outside supported bounds");
+        return;
+    }
+    getUserDataAs<CutefishShellSurface>(resource)->setPosition(x, y);
+}
+
+void shellSurfaceSetExclusiveZone(wl_client*, wl_resource* resource, uint32_t edge,
+                                 int32_t thickness, uint32_t yields)
+{
+    if (thickness < 0 || thickness > 16384 || yields > 1) {
+        wl_resource_post_error(resource, CUTEFISH_SHELL_SURFACE_V1_ERROR_INVALID_GEOMETRY,
+                               "invalid exclusive zone");
+        return;
+    }
+    std::optional<wm::ScreenEdge> parsed;
+    switch (edge) {
+    case CUTEFISH_SHELL_SURFACE_V1_EDGE_TOP: parsed = wm::ScreenEdge::Top; break;
+    case CUTEFISH_SHELL_SURFACE_V1_EDGE_BOTTOM: parsed = wm::ScreenEdge::Bottom; break;
+    case CUTEFISH_SHELL_SURFACE_V1_EDGE_LEFT: parsed = wm::ScreenEdge::Left; break;
+    case CUTEFISH_SHELL_SURFACE_V1_EDGE_RIGHT: parsed = wm::ScreenEdge::Right; break;
+    default:
+        wl_resource_post_error(resource, CUTEFISH_SHELL_SURFACE_V1_ERROR_INVALID_EDGE,
+                               "invalid exclusive-zone edge");
+        return;
+    }
+    getUserDataAs<CutefishShellSurface>(resource)->setExclusiveZone(*parsed, thickness, yields != 0);
+}
+
+void shellSurfaceClearExclusiveZone(wl_client*, wl_resource* resource)
+{
+    getUserDataAs<CutefishShellSurface>(resource)->clearExclusiveZone();
+}
+
+void shellSurfaceSetPanelBehavior(wl_client*, wl_resource* resource, uint32_t behavior)
+{
+    wm::PanelBehavior parsed;
+    switch (behavior) {
+    case CUTEFISH_SHELL_SURFACE_V1_PANEL_BEHAVIOR_STAY_ABOVE: parsed = wm::PanelBehavior::StayAbove; break;
+    case CUTEFISH_SHELL_SURFACE_V1_PANEL_BEHAVIOR_WINDOWS_CAN_COVER: parsed = wm::PanelBehavior::WindowsCanCover; break;
+    default:
+        wl_resource_post_error(resource, CUTEFISH_SHELL_SURFACE_V1_ERROR_INVALID_BEHAVIOR,
+                               "invalid panel behavior");
+        return;
+    }
+    getUserDataAs<CutefishShellSurface>(resource)->setPanelBehavior(parsed);
+}
