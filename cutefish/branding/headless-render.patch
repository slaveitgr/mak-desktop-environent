+
+std::unique_ptr<EglRenderer> EglRenderer::createSurfaceless()
+{
+    auto context = EglContext::createSurfaceless();
+    if (!context)
+        return nullptr;
+    auto renderer = std::unique_ptr<EglRenderer>(new EglRenderer(std::move(context)));
+    if (!renderer->initPrograms())
+        return nullptr;
+    return renderer;
 }
 
