+
+void Osd::publishExternalLevel(bool force)
+{
+    if (!m_service)
+        return;
+    // Only observations from PipeWire/brightness services cross this boundary.
+    // The pending values used to coalesce hardware key repeats are never UI state.
+    std::string kind, label;
+    double value = 0;
+    bool muted = false, available = false;
+    switch (m_kind) {
+    case Kind::Volume:
+        kind = "volume";
+        available = m_levels->sinkLevelAvailable();
+        value = m_levels->volume(); muted = m_levels->muted(); label = m_levels->sinkLabel();
+        break;
+    case Kind::Microphone:
+        kind = "microphone";
+        available = m_levels->microphoneLevelAvailable();
+        value = m_levels->microphoneVolume(); muted = m_levels->microphoneMuted(); label = m_levels->microphoneLabel();
+        break;
+    case Kind::Brightness:
+        kind = "brightness"; label = "Display";
+        available = m_levels->brightnessEnabled(); value = m_levels->brightness() / 100.0;
+        break;
+    case Kind::KeyboardBrightness:
+        kind = "keyboardBrightness"; label = "Keyboard";
+        available = m_levels->keyboardMaximum() > 0;
+        value = available ? double(m_levels->keyboardBrightness()) / m_levels->keyboardMaximum() : 0;
+        break;
+    }
+    available = available && std::isfinite(value);
+    value = available ? std::clamp(value, 0.0, 1.0) : 0;
+    const ExternalLevel level {kind, value, muted, label, available};
+    if (!force && m_lastExternalLevel == level)
+        return;
+    m_lastExternalLevel = level;
+    m_service->emitSignal("LevelChanged", kind, value, muted, label, available);
 }
 
