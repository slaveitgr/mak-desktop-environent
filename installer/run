#!/bin/sh
set -eu
MAKOS_SOURCE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export QT_QUICK_CONTROLS_STYLE=Basic
if [ -x "$MAKOS_SOURCE/cutefish/build/venv/bin/python" ]; then
    exec "$MAKOS_SOURCE/cutefish/build/venv/bin/python" "$MAKOS_SOURCE/installer/recovery.py" "$@"
fi
if [ -x "$MAKOS_SOURCE/../../work/qt-env/bin/python" ]; then
    exec "$MAKOS_SOURCE/../../work/qt-env/bin/python" "$MAKOS_SOURCE/installer/recovery.py" "$@"
fi
exec python3 "$MAKOS_SOURCE/installer/recovery.py" "$@"
